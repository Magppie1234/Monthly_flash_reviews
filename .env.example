# Local server
CLONE_PORT=3100
# Optional shared local access gate. Leave blank only on a trusted workstation.
ACCESS_CODE=
# Production-only Vercel Cron bearer secret. Do not reuse ACCESS_CODE or CRM_SQL_SECRET.
CRON_SECRET=

# Zoho CRM source connection (read-only use only)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CRM_ORG_ID=

# Local replica database
SUPABASE_URL=
SUPABASE_ANON_KEY=
CRM_SQL_SECRET=

# The default npm start command is snapshot-only and never initializes an
# external CRM/database/integration connection. Use an absolute path only when
# the private snapshot has been stored outside this project.
CRM_OFFLINE_SNAPSHOT_DIR=.private/offline-snapshot

# Attachment replication is isolated from the browser-facing anon key.
# The bucket name is intentionally not defaulted; it must exist and report public=false.
SUPABASE_SERVICE_ROLE_KEY=
ATTACHMENT_STORAGE_BUCKET=

# Required before any attachment over 6 MB can be transferred. The reviewed local
# module must export createResumableAttachmentUploader(context) or createUploader(context).
ATTACHMENT_RESUMABLE_ADAPTER_MODULE=

# Permission-scoped CRM data agent through Vercel AI Gateway. Configure either
# AI_GATEWAY_API_KEY or VERCEL_OIDC_TOKEN; leave both blank to keep the
# deterministic local-only fallback. Never expose these values to the browser.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
CRM_AGENT_MODEL=openai/gpt-5.6-sol

# Ozonetel CloudAgent foundation. The domestic API host and paths are fixed in
# code. Calls remain disabled unless the exact enable flag is set to true.
OZONETEL_API_KEY=
OZONETEL_USERNAME=
OZONETEL_REPORTING_TIMEZONE_OFFSET_MINUTES=
OZONETEL_OUTBOUND_CALLS_ENABLED=false
OZONETEL_WEBHOOK_SECRET=

# Picky Assist project foundation. Use the numeric channel/application ID shown
# in the project. Messages remain disabled unless the exact flag is set to true.
PICKY_ASSIST_API_TOKEN=
PICKY_ASSIST_APPLICATION_ID=
PICKY_ASSIST_PROJECT_ID=
PICKY_ASSIST_OUTBOUND_MESSAGES_ENABLED=false
PICKY_ASSIST_WEBHOOK_SECRET=

# Code a reviewer enters to see how each MIS figure is worked out (Show formulae).
# Leave blank to keep the button from revealing anything.
FORMULA_CODE=
